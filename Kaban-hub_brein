        pullConn = RunService.RenderStepped:Connect(function()
            if not config.Pull then return end
            local target = GetClosestTarget("HumanoidRootPart")
            if not target then return end
            local myChar = LocalPlayer.Character
            if not myChar then return end
            local myHrp = myChar:FindFirstChild("HumanoidRootPart")
            local myHum = myChar:FindFirstChildOfClass("Humanoid")
            if not myHrp or not myHum then return end
            local targetPos = target.part.Position
            local myPos = myHrp.Position
            local dir = targetPos - myPos
            if dir.Magnitude > 3 then
                myHum:MoveTo(myPos + dir.Unit * 0.4)
            end
        end)
    else
        if pullConn then pullConn:Disconnect(); pullConn = nil end
    end
end

-- ============================================
-- ФЛЮ (бесконечный прыжок)
-- ============================================
local infJumpConn = nil
local lastJumpTime = 0

local function ToggleInfiniteJump(state)
    config.Fly = state
    if state then
        if infJumpConn then infJumpConn:Disconnect() end
        infJumpConn = UserInputService.JumpRequest:Connect(function()
            if not config.Fly then return end
            local now = tick()
            if now - lastJumpTime < config.FlyCooldown then return end
            lastJumpTime = now
            local char = LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            local st = hum:GetState()
            hum.Jump = true
            if st == Enum.HumanoidStateType.Freefall then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local vel = hrp.AssemblyLinearVelocity
                    hrp.AssemblyLinearVelocity = Vector3.new(vel.X, config.FlyPower, vel.Z)
                end
            end
        end)
    else
        if infJumpConn then infJumpConn:Disconnect(); infJumpConn = nil end
    end
end

