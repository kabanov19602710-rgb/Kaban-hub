local BRAINROT_KEYWORDS = {
    "brainrot", "brain", "rot",
    "tralalero", "tralala", "bombardiro", "bombombini",
    "tung", "sahur", "tungtung", "patapim", "brr", "skibidi",
    "crocodilo", "crocodile", "cappuccino", "assassino",
    "lirili", "larila", "girafa", "celeste",
    "boneca", "ambalabu", "chimpanzini", "glorbo"
}

local function IsBrainrot(obj)
    if not obj then return false end
    local n = obj.Name:lower()
    for _, kw in ipairs(BRAINROT_KEYWORDS) do
        if n:find(kw, 1, true) then return true end
    end
    return false
end

-- ============================================
-- ПОИСК ЦЕЛИ
-- ============================================
local function GetClosestTarget(part)
    part = part or "Head"
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local bestTarget = nil
    local bestDist = config.AimFOV

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local targetPart = player.Character:FindFirstChild(part) or player.Character:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestTarget = {player = player, part = targetPart}
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

