local aimConn = nil
local function ToggleAimBot(state)
    if USER_TIER ~= "premium" then return end
    config.AimBot = state
    if state then
        if aimConn then aimConn:Disconnect() end
        aimConn = RunService.RenderStepped:Connect(function()
            if not config.AimBot then return end
