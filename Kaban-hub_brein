                local cam = Workspace.CurrentCamera
                if cam then
                    local desired = CFrame.new(cam.CFrame.Position, target.part.Position)
                    cam.CFrame = cam.CFrame:Lerp(desired, 1 - config.AimSmooth)
                end
            end
        end)
    else
        if aimConn then aimConn:Disconnect(); aimConn = nil end
    end
end

