local function ApplyAntiDetect()
    local oldPrint = print
    local oldWarn = warn
    _G.print = function(...)
        local text = tostring(({...})[1] or "")
        if text:find("KABAN") or text:find("kaban") then return end
        oldPrint(...)
    end
    _G.warn = function(...)
        local text = tostring(({...})[1] or "")
        if text:find("KABAN") or text:find("kaban") then return end
        oldWarn(...)
    end
    pcall(function()
        if game.GetObjects then
            game.GetObjects = function() return {} end
        end
    end)
end
ApplyAntiDetect()

local function ProtectGui(gui)
