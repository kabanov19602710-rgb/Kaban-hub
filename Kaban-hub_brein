            MainFrame.Size = UDim2.new(0, 480, 0, 650)
            TitleBar.Visible = true
            ContentFrame.Visible = true
            restoreBtn:Destroy()
            restoreBtn = nil
        end)
    end)

    print("[KABAN] HUB v10.0 загружен! Тариф: " .. USER_TIER)
end

